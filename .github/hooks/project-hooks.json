{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "bash .github/hooks/session-start.sh",
        "powershell": "& '.github/hooks/session-start.ps1'",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "bash .github/hooks/protect-files.sh",
        "powershell": "& '.github/hooks/protect-files.ps1'",
        "cwd": ".",
        "timeoutSec": 10
      }
    ]
  }
}
